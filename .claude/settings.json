{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run build)",
      "Bash(npm ci)",
      "Bash(npm start)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git switch *)",
      "PowerShell(npm test)",
      "PowerShell(npm test *)",
      "PowerShell(npm run build)",
      "PowerShell(npm ci)",
      "PowerShell(npm start)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git branch *)",
      "PowerShell(git fetch *)",
      "PowerShell(git pull *)",
      "PowerShell(git switch *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *-f)",
      "Bash(git push * main)",
      "Bash(npm audit fix --force*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push *-f *)",
      "PowerShell(git push *-f)",
      "PowerShell(git push * main)",
      "PowerShell(npm audit fix --force*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/test-before-commit.mjs\""
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(git commit *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/test-before-commit.mjs\""
          }
        ]
      }
    ]
  }
}
